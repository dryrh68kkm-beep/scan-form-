rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // ห้ามลบผ่าน client แม้ล็อกอินแล้ว (Anonymous Auth ทำให้ทุกคนล็อกอินได้เอง) —
      // ป้องกันไม่ให้ใครก็ได้ลบเอกสาร/รายชื่อพนักงาน/สินค้าทิ้งทั้งฐานได้ ใช้วิธี soft-delete
      // (ตั้งฟิลด์ active:false) แทนการลบจริงในทุกจุดที่แอปเคยเรียก fsDelete
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }
  }
}
